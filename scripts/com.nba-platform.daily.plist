<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/ and `launchctl load` it. Runs every 30 min from 10:00 to 23:30 local. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.nba-platform.daily</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>REPLACE_WITH_PATH/nba-platform/scripts/daily_mac.sh</string></array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Minute</key><integer>0</integer></dict><dict><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/tmp/nba-platform.out</string>
  <key>StandardErrorPath</key><string>/tmp/nba-platform.err</string>
</dict></plist>
